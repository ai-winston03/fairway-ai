rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    // The Next.js server (Firebase Admin SDK) owns all operational data.
    // Browsers receive only the API responses appropriate to their role.
    match /staffUsers/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow write: if false;
    }

    // Blocked outbound SMS log. Admin SDK only. Never store message body.
    match /sms_attempts/{id} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
